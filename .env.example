# Environment Configuration Template for AgentSphere Platform
# Copy this file to .env before starting services

# Application & Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-example
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-minimum-32-chars-example
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex for AES-256-GCM

# PostgreSQL & pgvector Database
DATABASE_URL=postgresql://agentsphere:agentsphere_secure_pw@localhost:5432/agentsphere_db
POSTGRES_USER=agentsphere
POSTGRES_PASSWORD=agentsphere_secure_pw
POSTGRES_DB=agentsphere_db
POSTGRES_PORT=5432

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# External Model Providers (Used by FastAPI Gateway or fallback mock)
OPENAI_API_KEY=mock-openai-key-for-local-development
ANTHROPIC_API_KEY=mock-anthropic-key-for-local-development
DEFAULT_MODEL_PROVIDER=mock
FALLBACK_MODEL_PROVIDER=mock

# Python Gateway Configuration
PYTHON_PORT=8000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_EXECUTION_STEPS=10
DEFAULT_TENANT_BUDGET_USD=50.00
